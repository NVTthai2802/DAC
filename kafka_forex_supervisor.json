{
  "type": "kafka",
  "spec": {
    "ioConfig": {
      "type": "kafka",
      "inputFormat": {
        "type": "json"
      },
      "consumerProperties": {
        "bootstrap.servers": "kafka:29092"
      },
      "topic": "forex_rates_topic",
      "useEarliestOffset": true
    },
    "dataSchema": {
      "dataSource": "forex_rates_topic",
      "timestampSpec": {
        "column": "timestamp",
        "format": "iso"
      },
      "dimensionsSpec": {
        "dimensions": [
          { "name": "asset", "type": "string" },
          { "name": "price", "type": "double" }
        ]
      },
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "MINUTE",
        "queryGranularity": "MINUTE",
        "rollup": false
      }
    },
    "tuningConfig": {
      "type": "kafka"
    }
  }
}