{
  "type": "kafka",
  "spec": {
    "ioConfig": {
      "type": "kafka",
      "consumerProperties": {
        "bootstrap.servers": "localhost:9092"
      },
      "topic": "forex_rates_full",
      "useEarliestOffset": true
    },
    "dataSchema": {
      "dataSource": "forex_rates_full",
      "timestampSpec": {
        "column": "timestamp",
        "format": "iso"
      },
      "dimensionsSpec": {
        "dimensions": [
          { "name": "currency", "type": "string" },
          { "name": "rate", "type": "double" },
          { "name": "quota_remaining", "type": "long" }
        ]
      },
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "DAY",
        "queryGranularity": "NONE",
        "rollup": false
      }
    },
    "tuningConfig": {
      "type": "kafka"
    }
  }
}