{
  "type": "kafka",
  "spec": {
    "ioConfig": {
      "type": "kafka",
      "consumerProperties": {
        "bootstrap.servers": "kafka-1:29092,kafka-2:29093,kafka-3:29094"
      },
      "topic": "osint_events_v2",
      "useEarliestOffset": true,
      "inputFormat": {
        "type": "json"
      },
      "taskCount": 2
    },
    "dataSchema": {
      "dataSource": "osint_events_v2",
      "timestampSpec": {
        "column": "timestamp",
        "format": "iso"
      },
      "dimensionsSpec": {
        "dimensions": [
          "title",
          "source",
          "summary",
          "link",
          "status",
          { "name": "matched_keywords", "type": "string" },
          { "name": "latitude", "type": "double" },
          { "name": "longitude", "type": "double" }
        ]
      },
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "MINUTE",
        "queryGranularity": "MINUTE",
        "rollup": false
      }
    },
    "tuningConfig": {
      "type": "kafka"
    }
  }
}